  time: string;
  activity: string;
  description?: string;
  colour: string;
};

type Table = {
  date: string;
  rows: Row[];
};

const tblContents = [
  {
    index: "01",
    path: "#about",
    label: "About",
  },
  {
    index: "02",
    path: "#schedule",
    label: "Schedule",
  },
  {
    index: "03",
    path: "#pre-conference",
    label: "Pre-Conference",
  },
  {
    index: "04",
    path: "#youth-pavilion",
    label: "Youth Pavilion",
  },
  {
    index: "05",
