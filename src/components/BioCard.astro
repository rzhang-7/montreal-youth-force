---
const { bgColour, person } = Astro.props;
---

<div class="card flex-1">
  <img class="w-full" src={person.img.src} alt={person.img.alt} />
  <!-- https://letsstopaids.org/about#leadership -->
  <h3 class="text-3xl font-subheading font-semibold py-2.5">{person.name}</h3>
  <h4 class="text-lg font-subheading pb-6">{person.title}</h4>
  <div class="text-center">
    <button
      class={`read-more border-2 border-current w-full py-4 ${
        bgColour === "black"
          ? "hover:bg-merino hover:text-black"
          : "hover:bg-black hover:text-merino"
      }`}
    >
      Read More
    </button>
  </div>
  <!-- FIXME: Does not work on carousel, need to add mobile styles -->
  <div
    class="overlay hidden fixed left-0 top-0 z-10 w-screen h-screen bg-black/80"
  >
    <div class="mx-[5vw] sm:mx-[10vw] bg-merino text-grey max-h-[80%] overflow-auto flex flex-col md:flex-row gap-8 m-auto p-8">
      <div class="basis-2 md:order-last flex items-start justify-end">
        <button class="close" type="button" aria-label="Close Bio">
          <span
            class="block w-4 h-0.5 mx-auto rounded-sm bg-black translate-y-0.5 -rotate-45"
          ></span>
          <span class="block w-4 h-0.5 mx-auto rounded-sm bg-black rotate-45"
          ></span>
        </button>
      </div>
      <div class="flex-1"><img class="w-full h-full object-cover" src={person.img.src} alt={person.img.alt} /></div>
      <article class="flex-1">
        <h3 class="text-3xl font-subheading">{person.name}</h3>
        <h4 class="text-lg font-subheading py-2.5">{person.title}</h4>
        <p class="text-base font-base">{person.bio}</p>
      </article>
    </div>
  </div>
</div>

<script>
  import { toggleCSSClasses } from "../scripts/script.ts";

  const cards = document.querySelectorAll("div.card");

  cards.forEach((card) => {
    const readMoreButton = card.querySelector(
      "button.read-more"
    ) as HTMLButtonElement;
    const overlay = card.querySelector("div.overlay") as HTMLDivElement;
    const closeButton = card.querySelector(".close") as HTMLButtonElement;
    if (readMoreButton) {
      readMoreButton.addEventListener("click", () => {
        toggleCSSClasses(overlay, "hidden", "flex");
      });
      closeButton.addEventListener("click", () => {
        toggleCSSClasses(overlay, "hidden", "flex");
      });
    }
  });
</script>
