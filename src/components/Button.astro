---
interface Props {
  text: string;
  src: string;
  bgColour?: string;
  fontColour?: string;
  hoverBgColour?: string
  display?: string;
}

const { text, src, bgColour="bg-black", fontColour="text-merino", hoverBgColour="bg-red", display="inline-block"} = Astro.props;
---

<a
  href={src}
  target="_blank"
  class={`${bgColour} ${fontColour} ${display} hover:${hoverBgColour} hover:text-merino font-heading text-base sm:text-2xl text-center py-3 px-3 sm:px-10 sm:py-4 lg:px-20`}
>
  {text}
</a>
