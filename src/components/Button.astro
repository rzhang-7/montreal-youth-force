---
interface Props {
  src: string;
  bgColour?: string;
  fontColour?: string;
  hoverBgColour?: string
  display?: string;
}

const { src, bgColour="bg-black", fontColour="text-merino", hoverBgColour="bg-red", display="inline-block"} = Astro.props;

const renamedHoverBgColour = `hover:${hoverBgColour}`;
---
<!-- ! Colours aren't rendered -->
<!-- https://tailwindcss.com/docs/content-configuration#dynamic-class-names -->
<a
  href={src}
  target="_blank"
  class={`${bgColour} ${fontColour} ${display} ${renamedHoverBgColour} hover:text-merino font-heading text-base sm:text-2xl text-center py-3 px-3 sm:px-10 sm:py-4 lg:px-20`}
>
  <slot/>
</a>
