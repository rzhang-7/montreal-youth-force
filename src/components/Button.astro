---
interface Props {
  src: string;
  bgColour?: string;
  fontColour?: string;
  display?: string;
}

const { src, bgColour="bg-black", fontColour="text-merino", display="inline-block"} = Astro.props;

---
<a
  href={src}
  target="_blank"
  class={`${bgColour} ${fontColour} ${display} ${bgColour === "bg-red" ? "hover:bg-black" : "hover:bg-red"} hover:text-merino font-heading text-base sm:text-2xl text-center py-3 px-3 sm:px-10 sm:py-4 lg:px-20`}
>
  <slot/>
</a>
