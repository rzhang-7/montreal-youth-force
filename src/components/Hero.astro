<section class="h-screen overflow-hidden pb-5vh sm:p-0">
  <div
    class="object-none flex content-center justify-center px-5vw lg:px-0 pt-10vh sm:pt-10vh"
  >
    <!-- https://easings.net/#easeInOutCubic -->
    <img
      class="will-change-transform animate-[slidein_1s_cubic-bezier(0.65,0,0.35,1)_1]"
      src="https://res.cloudinary.com/letsstopaids/image/upload/f_auto,q_auto/v1/MonrealYouthForce/logo/myf2022-black"
      alt="Montreal Youth Force 2022"
    />
  </div>
  <div
    class="flex mt-[-20vh] sm:mt-0 sm:block flex-row content-center justify-between h-full lg:h-[60vh]"
  >
    <div class="block static w-screen sm:hidden">
      <img
        class="w-screen"
        src="https://res.cloudinary.com/letsstopaids/image/upload/f_auto,q_auto/v1/MonrealYouthForce/home/hero-sm"
        alt="hero image"
      />
    </div>
    <div
      class="hidden sm:inline-block w-screen h-auto object-fill relative lg:top-[-35vh] top-[-10vh]"
    >
      <img
        data-scroll
        data-scroll-css-progress
        data-scroll-offset="0, 100%"
        class="w-screen will-change-transform scale-[calc(1+var(--progress)*0.2)]"
        src="https://res.cloudinary.com/letsstopaids/image/upload/f_auto,q_auto/v1/MonrealYouthForce/home/hero"
        alt="hero image"
      />
    </div>
  </div>
</section>
